# The shop's database. A file on the shop's own disk, not a connection string.
# Nothing in this project talks to a database over a network.
DATABASE_PATH=pharmacy.db

# The shop's own stock list. One brand per line. Falls back to a starter list.
# FORMULARY_PATH=formulary.txt

# Local open-weight model via Ollama.
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b

# Below this, a line goes to the pharmacist instead of onto the counter.
CONFIDENCE_THRESHOLD=0.8

# Optional integrations
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SENTRY_DSN=

# Deterministic fixtures instead of calling Ollama. The hosted demo sets this,
# because the free instance it runs on has no GPU and cannot hold a 3.4 GB model.
DEMO_MODE=false
